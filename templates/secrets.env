# Ключи доступа к данным сайта. Этот файл никуда не отправляется и в чат не показывается.
# Вписывай значение сразу после знака =, без кавычек и пробелов. Как получить каждый ключ:
# references/onboarding.md в папке скилла.

# Яндекс.Метрика и Яндекс.Вебмастер: один OAuth-токен на оба сервиса
YANDEX_OAUTH_TOKEN=

# Wordstat и выдача Яндекса: API-ключ Yandex Search API и идентификатор каталога
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=

# Google Search Console ключом не вписывается: файл сервисного аккаунта кладется рядом
# под именем gsc-service-account.json

# Логи сервера по FTP (только если в site.json выбран "logs": {"source": "ftp"})
LOGS_FTP_USER=
LOGS_FTP_PASSWORD=
